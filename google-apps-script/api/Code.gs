function verifyRequest(b){var s=PropertiesService.getScriptProperties().getProperty('SCRIPT_FLOW_API_SECRET');if(!s||s.length<32)throw Error('SCRIPT_FLOW_API_SECRET is not configured.');var t=String(b.timestamp||''),n=String(b.nonce||'');if(!/^\d{10}$/.test(t)||!/^[A-Za-z0-9_-]{20,100}$/.test(n))throw Error('Invalid request authentication fields.');if(Math.abs(Math.floor(Date.now()/1000)-Number(t))>60)throw Error('Request expired.');if(!b.payload||typeof b.payload!=='object')throw Error('Missing payload.');var c=t+'\n'+n+'\n'+JSON.stringify(b.payload),sig=hex(Utilities.computeHmacSha256Signature(c,s,Utilities.Charset.UTF_8));if(!equal(sig,String(b.signature||'').toLowerCase()))throw Error('Unauthorized.');var lock=LockService.getUserLock();lock.waitLock(10000);try{var cache=CacheService.getScriptCache(),k='sf_req_'+n;if(cache.get(k))throw Error('Duplicate request.');cache.put(k,'1',180);}finally{lock.releaseLock();}}
